# 1Password template for a local OpenClaw gateway.
# This file is references only. It is safe to commit.
#
# Resolve it onto the machine, outside the repo:
#   umask 077
#   mkdir -p ~/.openclaw
#   op inject -i config/env.1password.example -o ~/.openclaw/.env
#   chmod 600 ~/.openclaw/.env
#
# Change the vault and item names to yours. Do not replace op:// with a real
# key and commit the result. The gateway reads ~/.openclaw/.env. A shell
# export is not visible to launchd or systemd.

OPENCLAW_GATEWAY_TOKEN=op://Personal/OpenClaw Gateway/credential

# Uncomment the one provider you intend to use. Leave the rest absent.
# ANTHROPIC_API_KEY=op://Personal/Anthropic/credential
# OPENAI_API_KEY=op://Personal/OpenAI/credential
# OPENROUTER_API_KEY=op://Personal/OpenRouter/credential
# XAI_API_KEY=op://Personal/xAI/credential
# GEMINI_API_KEY=op://Personal/Gemini/credential
# GROQ_API_KEY=op://Personal/Groq/credential

# Local Ollama does not need a real bearer token. The marker below is not a secret.
# OLLAMA_API_KEY=ollama-local
